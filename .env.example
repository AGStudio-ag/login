# 复制为 .env 仅用于本地测试；不要提交 .env
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/DATABASE?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_CREDENTIALS=111:replace-with-a-strong-password
RESEND_API_KEY=re_replace_me
PAYMENT_SECRET=replace-with-payment-callback-secret
PORT=8080
PYTHON_BIN=python3
# true 时自动签到只打印命中用户，不实际调用学校接口（测试用）
AUTO_SIGN_DRY_RUN=false
